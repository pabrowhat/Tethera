; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Tethera"
config/version="1.0.0"
run/main_scene="uid://bvyg7kq0v37pm"
config/use_custom_user_dir=true
config/custom_user_dir_name="Tethera"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/show_image=false
boot_splash/use_filter=false
config/icon="uid://bc5yjf3sdpcom"
config/macos_native_icon="res://assets/icon_macos.icns"
config/windows_native_icon="res://icon.ico"

[display]

window/size/mode=3
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/default_font_multichannel_signed_distance_field=true
theme/custom="res://themes/app_theme.tres"

[internationalization]

locale/translations=PackedStringArray("res://locale/en.po", "res://locale/ru.po")

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_2d=2
