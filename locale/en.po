msgid "whats_new.1_1_0.hotkeys"
msgstr "New shortcuts: Ctrl+N (new note), Ctrl+E (Edit / View), Ctrl+A (select all), Ctrl+D (duplicate) and P (Project menu)."

msgid "whats_new.1_1_0.clipboard"
msgstr "Notes can be copied, cut and pasted with Ctrl+C, Ctrl+X and Ctrl+V. Links between the copied notes are kept."

msgid "whats_new.1_1_0.shortcut_list"
msgstr "The Ctrl+K palette has a \"Keyboard shortcuts\" command with the list of all shortcuts."

msgid "whats_new.1_2_0.light_theme"
msgstr "New light theme: panels, menus, dialogs, the canvas and its dot grid, the start screen and the PNG export follow it."

msgid "whats_new.1_2_0.theme_setting"
msgstr "Choose the theme in Settings. It applies on Save, with no restart. The colours you chose for notes do not change."

msgid "whats_new.1_2_0.macos_vault_dialog"
msgstr "Fixed: on macOS, the Vault folder dialog could get stuck after choosing a folder."

msgid "settings.theme.auto"
msgstr "Auto"

msgid "type.character"
msgstr "Character"

msgid "type.event"
msgstr "Event"

msgid "type.place"
msgstr "Place"

msgid "type.faction"
msgstr "Faction"

msgid "type.item"
msgstr "Item"

msgid "whats_new.1_3_0.type_names"
msgstr "The standard types (Character, Event, Place, Faction, Item) now follow the interface language. A type you rename keeps your name."

msgid "whats_new.1_3_0.theme_auto"
msgstr "New theme choice \"Auto\": the theme matches the system at launch and on Save. It is the default for new installs."

msgid "whats_new.1_3_0.settings_scroll"
msgstr "Fixed: in Settings, the Advanced section no longer pushes controls out of view. The content scrolls, Save and Cancel stay at the bottom."


msgid "whats_new.1_3_0.light_aurora"
msgstr "The aurora on the start screen is easier to see in the light theme."

msgid "whats_new.1_3_0.license_window"
msgstr "Licences open in a window of their own that is larger and easier to read."

msgid "whats_new.1_3_0.start_focus"
msgstr "Fixed: on the start screen, no world shows a focus frame at launch, and the frame follows the keyboard (Up, Down, Tab) without leaving copies behind."

msgid "whats_new.1_3_0.reduce_motion"
msgstr "\"Reduce motion\" now also turns off the appear animation of notes and pictures, the springy lag of a dragged card and the animation of links appearing and disappearing."

msgid "whats_new.1_3_0.delete_animation"
msgstr "Notes and pictures now fade out and shrink when deleted (instant with \"Reduce motion\")."

