msgid "settings.minimap_decor"
msgstr "Show pictures and text in the minimap"

msgid "settings.layout"
msgstr "Layout spacing"

msgid "settings.layout.level_gap"
msgstr "Between levels"

msgid "settings.layout.sibling_gap"
msgstr "Between cards in a row"

msgid "settings.layout.block_gap"
msgstr "Between separate groups"

msgid "settings.layout.ring_step"
msgstr "Smallest step between rings"

msgid "settings.layout.hint"
msgstr "Used by the “Arrange” menu, in canvas pixels."

msgid "whats_new.1_4_0.rename"
msgstr "Renaming a note now rewrites [[old name]] in every note that links to it, in one undo step. If some note cannot be written, the app says how many were not updated."

msgid "whats_new.1_4_0.reconcile"
msgstr "The [[...]] text of the notes is the source of truth for links. When you save, the saved links are checked against the text: a link made from [[...]] disappears when you remove the [[...]], and a new [[...]] to an existing note makes a link."

msgid "whats_new.1_4_0.marks"
msgstr "Every link is “from text”, “drawn by hand” (Ctrl+click) or both. Removing [[...]] clears only the “from text” mark, so a hand-drawn link stays."

msgid "whats_new.1_4_0.mismatch"
msgstr "When you open an older world or import a .tether file and the saved links disagree with the text, one window lists them. Choose Keep or Remove for each row, or apply one choice to all. Closing the window changes nothing."

msgid "whats_new.1_4_0.minimap_decor"
msgstr "The minimap shows pictures and text labels as plain boxes, in the same order as on the canvas, and a click on a box moves the canvas to it. It can be turned off in Settings > Advanced."

msgid "whats_new.1_4_0.layout_spacing"
msgstr "Settings > Advanced has the spacing used by “Arrange”: between levels, between cards, between groups and between rings."

msgid "worlds.error.name_taken"
msgstr "A world with this name already exists. Letter case is ignored."

msgid "settings.collapse_distant_notes"
msgstr "Collapse notes into pills when zoomed out"

msgid "settings.collapse_distant_notes.tip"
msgstr "When off, notes keep their full size at any zoom. A very distant view of many notes may be slower."

msgid "whats_new.1_4_0.world_names_unique"
msgstr "World names are now unique: a new or renamed world cannot take a name that another world already has, whatever the letter case. Existing worlds with the same name are left as they are."

msgid "whats_new.1_4_0.collapse_setting"
msgstr "Settings > Advanced can turn off the collapse of notes into pills when you zoom out. Notes then keep their full size at any zoom."

msgid "command.open_selected_note"
msgstr "Open selected note"

msgid "settings.open_mode"
msgstr "Open notes"

msgid "settings.open_mode.hint"
msgstr "What a click on a note does. With “Do not open”, a note opens only with Enter or the “Open selected note” command (Ctrl+K)."

msgid "settings.open_mode.sidebar"
msgstr "In the side panel"

msgid "settings.open_mode.zen"
msgstr "In Zen mode"

msgid "settings.open_mode.none"
msgstr "Do not open"

msgid "whats_new.1_5_0.markdown"
msgstr "Notes understand more Markdown and BBCode: numbered lists, quotes, horizontal rules, code blocks with a copy button, tables and block alignment. Each BBCode tag is now checked on its own, so one wrong tag no longer spoils the rest of the note."

msgid "whats_new.1_5_0.checklists"
msgstr "Checklists: lines that start with “- [ ]” or “- [x]” show check boxes. In View mode a click on a box ticks it."

msgid "whats_new.1_5_0.align_buttons"
msgstr "The format toolbar has buttons for checklists and for left, centre and right alignment."

msgid "whats_new.1_5_0.label_alignment"
msgstr "Text labels on the canvas can be aligned left, centre or right in their editor."

msgid "whats_new.1_5_0.label_alignment_old"
msgstr "Text labels made in older versions have no alignment data and show left-aligned. If you save a world in 1.3.0 or 1.4.0, the alignment of its labels is lost."

msgid "whats_new.1_5_0.back_face"
msgstr "The back of a note shows its type fields, outgoing links, hand-drawn links and a word count, on the same background as the front."

msgid "whats_new.1_5_0.open_mode"
msgstr "Settings has a new “Open notes” choice: in the side panel (as before), in Zen mode on a click, or not at all. With “Do not open”, press Enter or use the “Open selected note” command (Ctrl+K)."

msgid "whats_new.1_5_0.zen"
msgstr "Zen mode is wider and taller, always shows the Edit / View switch and the format toolbar, and hides the Appearance block. A note opened by a click or Enter closes completely on Esc and the selection is cleared; a note opened with the Zen button returns to the side panel."

msgid "whats_new.1_5_0.ctrl_e"
msgstr "Ctrl+E switches between Edit and View in Zen mode too."

msgid "whats_new.1_5_0.inline_code"
msgstr "Inline code: text between single backticks, such as `.tether`, is shown in the monospace font and is not formatted. The format toolbar has buttons for inline code and for a code block."

msgid "whats_new.1_5_0.code_autoclose"
msgstr "In the editor, Enter on a line with only three backticks adds the closing line and puts the caret between them."

msgid "whats_new.1_5_1.cover_delete_row"
msgstr "In the note panel, Cover and Delete are now in a row under the type chooser, and the footer is gone."

msgid "whats_new.1_5_1.zen_appearance"
msgstr "Zen mode has an Appearance panel: border colour, type, cover, delete and background."

msgid "whats_new.1_5_1.link_styles"
msgstr "Two new link styles: dash-dot and double. Older versions show them as the default style and lose them on save."

msgid "whats_new.1_5_1.palette_edit"
msgstr "Default and custom colours can be changed or reset from a right-click menu. Notes keep their colours."

msgid "whats_new.1_5_1.clean_swatches"
msgstr "Colour swatches and the copy button icon in the colour picker are drawn cleanly."

msgid "whats_new.1_5_2.faster_open"
msgstr "Worlds open faster: notes appear first and their pictures load right after, and pictures are not decoded again when you reopen a world."

msgid "whats_new.1_5_2.backup_later"
msgstr "The daily backup is taken after the world is shown, not before."
