msgstr "The link between “%s” and “%s” has no [[...]] in the text."

msgid "links.mismatch.stale.hint"
msgstr "Keep: the link stays, marked as drawn by hand. Remove: the link is deleted."

msgid "links.mismatch.unlinked"
msgstr "“%s” mentions [[%s]], but there is no link."

msgid "links.mismatch.unlinked.hint"
msgstr "Keep: the link is created. Remove: the brackets are taken off in the text."

